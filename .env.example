SUPABASE_SECRET_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
# US: https://api.mailgun.net | EU: https://api.eu.mailgun.net
MAILGUN_API_BASE_URL=https://api.mailgun.net
